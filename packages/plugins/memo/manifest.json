{
  "id": "ext-memo",
  "name": "便签助手插件",
  "version": "1.0.0",
  "main": "index.js",
  "requires": [
    "@openlearn/core:ICommandBusService@^1.0.0",
    "@openlearn/core:IActionRegistryService@^1.0.0"
  ],
  "capabilitiesProposed": [
    "whiteboard:write"
  ],
  "engines": {
    "openlearn": "^2.5.0"
  },
  "contributes": {
    "classroom.tool": [
      {
        "id": "tool-memo",
        "name": "新建便签",
        "icon": "StickyNote",
        "description": "在画板上放置一个彩色的文字便签",
        "commandType": "memo.create",
        "payload": {}
      }
    ]
  }
}
