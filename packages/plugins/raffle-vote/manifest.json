{
  "id": "ext-raffle-vote",
  "name": "课堂实时投票与抽奖转盘",
  "version": "1.0.0",
  "main": "index.js",
  "requires": [
    "@openlearn/core:ICommandBusService@^1.0.0",
    "@openlearn/core:IActionRegistryService@^1.0.0",
    "@openlearn/core:IEventBusService@^1.0.0"
  ],
  "capabilitiesProposed": [
    "whiteboard:write",
    "vfs:write"
  ],
  "engines": {
    "openlearn": "^2.5.0"
  },
  "contributes": {
    "classroom.tool": [
      {
        "id": "tool-vote",
        "name": "新建投票",
        "icon": "Vote",
        "description": "在画板上放置一个实时的课堂投票图表",
        "commandType": "vote.create",
        "payload": {
          "title": "你对本次课堂内容的理解程度？",
          "options": [
            "完全听懂了",
            "半懂不懂",
            "完全没听懂"
          ]
        }
      },
      {
        "id": "tool-raffle",
        "name": "课堂抽奖",
        "icon": "Gift",
        "description": "从选课学生中随机挑选一名幸运儿",
        "commandType": "raffle.draw",
        "payload": {}
      }
    ]
  }
}
