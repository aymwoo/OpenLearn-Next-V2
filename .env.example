# AI Providers: Configured dynamically via the Admin Dashboard ("AI Provider Management").
# Supports any OpenAI-compatible API (e.g., DeepSeek, Qwen, Ollama, OpenAI).
# No static AI API key is needed in this file.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
