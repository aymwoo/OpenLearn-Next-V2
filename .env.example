# AI Providers: Configured dynamically via the Admin Dashboard ("AI Provider Management").
# Supports any OpenAI-compatible API (e.g., DeepSeek, Qwen, Ollama, OpenAI).
# No static AI API key is needed in this file.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PLUGIN_COMMUNITY_REGISTRY_URL: Remote JSON registry powering the "Community" tab
# of the Plugin Center, where administrators discover and one-click install plugins.
# Leave empty to disable the community market (the UI then shows a setup hint).
# Only public HTTP(S) endpoints are accepted; loopback and private ranges are blocked.
# Schema reference: docs/plugin/community-plugin-registry.md
PLUGIN_COMMUNITY_REGISTRY_URL=""

# ── 插件隔离（L-1）───────────────────────────────────────────────────────────
# 未列入白名单、且文件不在内置目录的插件默认 executionMode=process：
# 独立子进程 + 最小环境变量，不继承密钥类变量。清单里的 inline/worker 会被忽略。
# id 以 @openlearn/ 开头不能单独获得进程内身份。
# OPENLEARN_WORKER_ISOLATE 只影响「未显式指定 isolateKind」的实例；
# 第三方插件激活时会显式传入 process，不会被这里的 thread 默认值拉回同进程。
# OPENLEARN_WORKER_ISOLATE: 'thread'（默认，worker_threads，同进程）
#   | 'process'（child_process 子进程 + 最小环境变量白名单）。
OPENLEARN_WORKER_ISOLATE="thread"

# OPENLEARN_TRUSTED_INLINE_PLUGINS: 逗号分隔的 manifest id，精确匹配。
# 名单内的插件可以按清单使用 inline 或 worker（与宿主共享进程与环境变量）。
# 预加载的内置插件和 packages/plugins 目录里的入口另有放行，不靠这份名单。
# OPENLEARN_TRUSTED_INLINE_PLUGINS=""

# OPENLEARN_COMMUNITY_INSTALL: 设为 1 才允许从社区注册表安装或更新。
# 默认关闭。打开后还要提供 integrity、signature 和下面的公钥。
# OPENLEARN_COMMUNITY_INSTALL=""

# OPENLEARN_COMMUNITY_PUBKEY: Ed25519 公钥 PEM。换行写成 \n。
# 签名覆盖 integrity 字符串的 UTF-8 字节。
# OPENLEARN_COMMUNITY_PUBKEY=""

# OPENLEARN_RESEARCH_SQL_PLUGINS: 允许访问 plugin_research_ 表的 manifest id，精确匹配。
# 不设置时默认只有 lianyun-course。设成空字符串则谁都不能访问研究表。
# OPENLEARN_RESEARCH_SQL_PLUGINS=""

# OPENLEARN_PLUGIN_PERMISSION: Node 权限模型的能力面收敛档位，**仅对子进程原语生效**。
#   rw  （默认）可读自己的目录与共享依赖、可写自己的目录；禁 eval/new Function、
#                       禁拉子进程、禁建 worker
#   ro                同 rw，但不可写（适合纯计算类插件）
#   off               关闭权限模型，同时不加载出站网络入口脚本
#   出站原始 socket 与 DNS 默认拒绝。fetch / http(s) 只把已批准域名交给宿主代理。
#   批准记录在 plugin_network_grants，不会从清单自动写入。
OPENLEARN_PLUGIN_PERMISSION="rw"

# OPENLEARN_PLUGIN_MAX_HEAP_MB: 插件可用 V8 老生代上限（MB），**仅对子进程原语生效**。
#   默认 128 —— 与 worker_threads 的 resourceLimits.maxOldGenerationSizeMb 同值
#   （同一常量，两种隔离原语不会漂移）。
#   ⚠ 只管 V8 老生代。Buffer/TypedArray/ArrayBuffer 等 **external 内存不受约束**，
#     native 模块分配的内存也不受约束。
#   ⚠ 128MB 对以下五个重型共享依赖已实测有余量：uuid / exceljs / jspdf /
#     react-markdown / recharts 全部加载后 heapUsed=35MB。
#   设为 0 或 off 可关闭上限 —— 仅在确认插件合法需要超大内存时才这么做，
#   因为内存失控可能导致系统 OOM 把**宿主进程**一起带走。
OPENLEARN_PLUGIN_MAX_HEAP_MB="128"

# OPENLEARN_PLUGIN_MAX_RSS_MB: 子进程 RSS 上限（MB），默认 512。0 或 off 关闭这一项。
# OPENLEARN_PLUGIN_CPU_QUOTA_MS / OPENLEARN_PLUGIN_CPU_WINDOW_MS: 每个时间窗允许的 CPU 毫秒，默认 8000 / 10000。
# OPENLEARN_PLUGIN_QUOTA=off 同时关闭 RSS 与 CPU 采样。采样只在 Linux /proc 上生效。
# OPENLEARN_PLUGIN_MAX_RSS_MB="512"
# OPENLEARN_PLUGIN_CPU_QUOTA_MS="8000"
# OPENLEARN_PLUGIN_CPU_WINDOW_MS="10000"

# OPENLEARN_WORKER_LIVENESS: 存活探活（P0）。卡死但没崩溃的插件会被终止，
#   默认 30s 探活间隔 + 15s 宽限 ⇒ 最长 45s 内终止。设为 off 关闭。
OPENLEARN_WORKER_LIVENESS="on"

# ── 服务端（最小示例之外的完整清单见 docs/configuration/system-configuration.md）──
# 启动期会强校验以下安全相关变量：拼写错误/越界值/生产弱口令会直接拒绝启动（见 §5）。
# PORT: HTTP 监听端口，默认 9000（server.ts / vite.config.ts / cli.mjs / playwright 共识）
# PORT="9000"
# HOST: 监听地址，默认 0.0.0.0（容器）/ localhost（本地）
# HOST=""
# NODE_ENV: development | production | test；dist/server.cjs 无显式值时默认 production
# NODE_ENV="development"
# ENCRYPTION_KEY: 64 位 hex。加密 AI Provider API Key 与班级临时口令。
# 留空时首次启动会生成 storage/encryption-key（0600），并在日志里警告应改设本变量且离线备份该文件。
# 不要写成空字符串占位；若与 storage/encryption-key 不一致，进程会拒绝启动。
# ENCRYPTION_KEY=""
# OPENLEARN_DB_PATH: SQLite 路径，默认 packages/core/db/educational_os.db；npx 默认 ~/openlearn-next/data.db
# OPENLEARN_DB_PATH=""
# OPENLEARN_DATA_DIR: 课件 storage、插件目录、上传文件的根。未设置时用 OPENLEARN_DB_PATH 的父目录。
# 容器镜像默认 /data，库文件为 /data/educational_os.db。
# OPENLEARN_DATA_DIR=""
# BACKUP_DIR: 备份目录。容器镜像默认 /backups。
# BACKUP_DIR=""
# ALLOWED_ORIGINS: CORS 白名单逗号分隔；含 * 时降级为无凭证 *（勿与凭证同用）。未设则同源+回环放行。
# ALLOWED_ORIGINS=""
# LOG_LEVEL: 结构化日志级别。生产默认 info，开发默认 debug。pino 直接读取。
# LOG_LEVEL="info"
# LOG_CONSOLE_LEVEL: 可选。独立设置控制台输出级别。未设置时继承 LOG_LEVEL。
# LOG_CONSOLE_LEVEL=""
# HTTP_ACCESS_LOG: HTTP 请求访问日志策略。
#   errors（默认）：仅记录 4xx/5xx 异常响应以及超过慢请求阈值的请求，消除 200/304 轮询刷屏；
#   all：记录全量访问日志（正常请求输出为 debug 级别，排障时使用）；
#   off：关闭 http.request 访问日志输出（不影响指标统计与安全审计）。
# HTTP_ACCESS_LOG="errors"
# HTTP_SLOW_MS: 慢请求阈值（毫秒）。耗时达到或超过此阈值的请求以 warn 级别记录 http.request。默认 1000。
# HTTP_SLOW_MS="1000"
# HTTP_ACCESS_LOG_IGNORE: 可选。逗号分隔的前缀名单（如 /api/vfs,/api/classroom/sessions/），忽略特定高频接口的正常访问日志。
# HTTP_ACCESS_LOG_IGNORE=""
# LOG_DIR: 日志目录，默认 <cwd>/logs。容器 compose 设为 /data/logs。
# LOG_DIR=""
# LOG_REDACT: 脱敏开关，默认开启。生产不要设为 false。
# LOG_REDACT=""
# LOG_MAX_SIZE_MB / LOG_MAX_FILES: 访问日志按大小轮转。默认 10MB × 5 份历史。
# LOG_MAX_SIZE_MB="10"
# LOG_MAX_FILES="5"
# AUDIT_LOG_MAX_SIZE_MB / AUDIT_LOG_MAX_FILES: 安全审计日志轮转。默认 20MB × 20 份。
# AUDIT_LOG_MAX_SIZE_MB="20"
# AUDIT_LOG_MAX_FILES="20"
# OPENLEARN_EVENT_RETENTION_DAYS: 启动时删除 SQLite events 表里早于 N 天的总线事件。默认 90。
# 设为 0 则不删除。安全审计文件 audit.log 不受影响。
# 需要更长历史时，在第一次用带此清理的版本重启之前设置，并先备份数据库。
# OPENLEARN_EVENT_RETENTION_DAYS="90"
# OPENLEARN_RETENTION_PENDING_COMMANDS_DAYS: 启动时删除 pending_commands 里早于 N 天的
# 待审批高危指令。默认 14 —— 一条两周无人审批的指令已失去上下文，不如清掉。
# 设为 0 则不删除（注意：插件卸载与审批失效仍会即时清理对应记录，不受此开关影响）。
# OPENLEARN_RETENTION_PENDING_COMMANDS_DAYS="14"
# OPENLEARN_SKIP_PASSWORD_CHANGE_GATE: 【仅本地开发/联调】跳过 SEC-AUTH-06 强制改密门。
# 打开后使用 admin/admin 这类默认口令登录不再触发全屏改密页，便于反复重启联调。
# 硬约束：NODE_ENV=production 时该变量被严格忽略并输出告警 —— 生产环境绝不放行。
# 别名：DEV_BYPASS_PASSWORD_CHANGE_GATE（同义）。
# OPENLEARN_SKIP_PASSWORD_CHANGE_GATE="false"
# SENTRY_DSN / OPENLEARN_ERROR_DSN: 可选。Sentry 兼容 DSN（自建 Sentry 或 GlitchTip）。
# 留空则只把脱敏后的错误写入日志，不向外发送。
# SENTRY_DSN=""
# OPENLEARN_ERROR_DSN=""
# METRICS_TOKEN: 可选。设置后可用 Authorization: Bearer 拉取 /metrics。
# 不设置时只有管理员会话能访问。匿名请求一律 401。
# METRICS_TOKEN=""
# TRUST_PROXY: Express trust proxy。默认不信任 X-Forwarded-*（直连部署）。
# Nginx 等反向代理之后必须显式设置，例如一层代理 TRUST_PROXY=1，或 TRUST_PROXY=loopback。
# 把服务直接暴露在公网时不要设为 1，否则客户端可伪造 X-Forwarded-For 拆开写请求限流桶。
# TRUST_PROXY=""
# 种子账号初始口令。留空则首次启动随机生成，并写入 storage/bootstrap-credentials.txt。
# 若值与用户名相同，登录后必须修改，期间业务 API（含 GET）会被拦截。
# OPENLEARN_ADMIN_PASSWORD=""
# OPENLEARN_TEACHER_PASSWORD=""
# BRIDGE_HOOK_TELEMETRY: 课件网络遥测（fetch/XHR/axios/beacon/form 上报父窗口）总闸，
#   默认开启；设为 off 关闭（课件上报仅落本地审计日志，不影响成绩提交）
# BRIDGE_HOOK_TELEMETRY="on"

# ROUTE_SCOPE_ENFORCE: 路由数据范围门禁（Issue #140）。设为 true 时，任何未用
# requireScopedAuth('<scope>') 声明数据范围的已认证路由都会阻止服务启动；
# 默认 false，仅在启动日志告警（迁移期）。
# ROUTE_SCOPE_ENFORCE="false"
