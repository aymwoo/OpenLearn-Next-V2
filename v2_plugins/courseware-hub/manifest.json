{
  "id": "@courseware-hub/plugin",
  "name": "课件中心",
  "version": "0.2.0",
  "description": "AI课件分发与成绩采集。不可变版本管理，VFS存储，学习心跳，安全扫描。",
  "author": "OpenLearn Developer",
  "requires": [
    "@openlearn/core:ICommandBusService@^1.0.0",
    "@openlearn/core:IActionRegistryService@^1.0.0",
    "@openlearn/core:IEventBusService@^1.0.0",
    "@openlearn/core:IDatabase@^1.0.0",
    "@openlearn/core:IAIService@^1.0.0",
    "@openlearn/core:IStorageService@^1.0.0",
    "@openlearn/core:ICapabilityService@^1.0.0",
    "@openlearn/core:ISemesterGradeService@^1.0.0"
  ],
  "capabilitiesProposed": [
    "courseware:read",
    "courseware:write",
    "courseware:admin",
    "lesson:read",
    "vfs:read",
    "vfs:write"
  ],
  "classroomTools": [
    {
      "id": "courseware-hub-teacher",
      "name": "课件管理",
      "icon": "BookOpen",
      "commandType": "whiteboard.draw",
      "payload": {
        "lessonId": "$lessonId",
        "type": "plugin",
        "data": "{\"pluginId\": \"@courseware-hub/plugin\", \"title\": \"课件管理\", \"teacherWidgetId\": \"courseware-hub-teacher\", \"studentWidgetId\": \"courseware-hub-student\", \"width\": 900, \"height\": 600}"
      }
    }
  ],
  "engines": {
    "openlearn": ">=2.5.0"
  },
  "contributes": {
    "teacher.dashboard.widget": [
      {
        "id": "courseware-hub-teacher",
        "label": "课件管理",
        "icon": "BookOpen"
      }
    ],
    "student.view": [
      {
        "id": "courseware-hub-student",
        "label": "我的课件",
        "icon": "BookOpen"
      }
    ]
  }
}
